@startuml "Colecciones MongoDB"
!theme mars
left to right direction

rectangle auth [
  auth
  --
  _id: ObjectId
  username: str <i>(unique)</i>
  password: str <i>(bcrypt)</i>
  status: "active" | "pending_deletion"
  scheduled_purge_at: datetime?
]

rectangle conversations [
  conversations
  --
  _id: ObjectId
  user_id: str
  updated_at: datetime
  title: str?
  messages: [{role, content}]
  stream_state: str?
  stream_partial_reply: str?
  stream_updated_at: datetime?
  stream_error: str?
]

rectangle meetings [
  meetings
  --
  _id: ObjectId
  user_id: str
  title: str
  date: datetime
  language: str?
  summary: str
  transcription: str
]

auth "1" ---- "N" conversations
auth "1" ---- "N" meetings

@enduml
