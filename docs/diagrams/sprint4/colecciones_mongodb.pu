@startuml "Colecciones MongoDB"
!theme mars
left to right direction

rectangle auth [
  auth
  --
  _id: ObjectId
  username: str <i>(unique)</i>
  password: str <i>(bcrypt)</i>
  status: "active" | "pending_deletion"
  scheduled_purge_at: datetime?
]

rectangle conversations [
  conversations
  --
  _id: ObjectId
  user_id: str
  updated_at: datetime
  title: str?
  messages: [{role, content}]
  stream_state: str?
  stream_partial_reply: str?
  stream_updated_at: datetime?
  stream_error: str?
]

rectangle meetings [
  meetings
  --
  _id: ObjectId
  user_id: str
  title: str
  date: datetime
  language: str?
  summary: str
  transcription: str
]

rectangle user_settings [
  user_settings
  --
  _id: ObjectId
  user_id: str
  settings: {
    providers: {
      OpenAI: {api_key?, base_url?}
      Anthropic: {api_key?, base_url?}
    }
    models: {
      chat_model: {provider, model, temp, max_tokens}
      summary_model: {provider, model, temp, max_tokens}
      retrieval_model: {provider, model, temp, max_tokens}
    }
    transcription: {
      active_provider: whisperx | aai
      whisperx: {model_size, compute_type, device}
      aai: {speech_model, speaker_labels, api_key?}
    }
    templates: {
      system_prompt: str?
    }
  }
]

auth "1" ---- "N" conversations
auth "1" ---- "N" meetings
auth "1" ---- "1" user_settings

@enduml
