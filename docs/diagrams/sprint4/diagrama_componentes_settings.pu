@startuml

!theme mars

left to right direction

package "routers" {
    [auth_router]
    [conversation_router]
    [meeting_router]

    package "settings_router" #LightBlue {
        [models_router] #Skyblue
        [providers_router] #Skyblue
        [templates_router] #SkyBlue
        [transcription_router] #Skyblue
    }
}

package "services" {
    [auth_service]
    [conversation_service]
    [meeting_service]
    package "settings_service" #LightBlue {
        [models_service] #Skyblue
        [providers_service] #Skyblue
        [templates_service] #SkyBlue
        [transcription_service] #Skyblue
    }
}

package "repositories" as repositories {
    [auth_repository]
    [conversation_repository]
    [meeting_repository]
    [settings_repository] #LightBlue
}

database "Base de Datos" as DB

auth_router *-- auth_service
conversation_router *-- conversation_service
meeting_router *-- meeting_service

models_router *-- models_service
providers_router *-- providers_service
templates_router *-- templates_service
transcription_router *-- transcription_service


models_service *-- settings_repository
providers_service *-- settings_repository
templates_service *-- settings_repository
transcription_service *-- settings_repository

auth_service *-- auth_repository
conversation_service *-- conversation_repository
meeting_service *-- meeting_repository



repositories -l-> DB

@enduml