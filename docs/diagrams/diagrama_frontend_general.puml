@startuml
!theme mars
title Visión General del Frontend — Memento

skinparam componentStyle rectangle
skinparam nodesep 30
skinparam ranksep 30

' ============================================================
' Nodos principales
' ============================================================
rectangle "Páginas y Rutas\n(React Router)" as ROUTES

rectangle "Componentes de Funcionalidad\n(chat · meetings · settings · auth · layout)" as FEATURES

rectangle "Componentes UI Genéricos\n(buttons · inputs · dialog · feedback)" as UI

rectangle "Estado del Cliente\nZustand" as ZUSTAND

rectangle "Estado del Servidor\nTanStack Query" as QUERY

rectangle "Capa de Comunicación\nfetch · WebSocket · SSE" as API

rectangle "Backend\nFastAPI" as BACKEND

' ============================================================
' Transversales
' ============================================================
rectangle "i18n\n(en / es)" as I18N #line.dashed
rectangle "Autenticación\n(JWT)" as AUTH #line.dashed

' ============================================================
' Flujo principal de dependencias
' ============================================================
ROUTES   -down-> FEATURES
FEATURES -down-> UI
ROUTES   -down-> ZUSTAND
FEATURES -down-> ZUSTAND
FEATURES -down-> QUERY
ZUSTAND  -down-> API
QUERY    -down-> API
API      -down-> BACKEND

' ============================================================
' Preocupaciones transversales
' ============================================================
I18N .right-> ROUTES
I18N .right-> FEATURES
I18N .right-> UI
AUTH -right-> API

@enduml
