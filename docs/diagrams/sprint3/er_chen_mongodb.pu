@startchen "Diagrama ER Notación Chen"
left to right direction

entity(auth, "Usuario (auth)") [
  * _id
  username
  password
  status
  scheduled_purge_at
]

entity(conv, "Conversacion (conversations)") [
  * _id
  # user_id
  updated_at
  title
  messages
  stream_state
  stream_partial_reply
  stream_updated_at
  stream_error
]

entity(meeting, "Reunion (meetings)") [
  * _id
  # user_id
  title
  date
  language
  summary
  transcription
]

relation(posee, auth, conv) "1" - "N"
relation(posee, auth, meeting) "1" - "N"
@endchen
