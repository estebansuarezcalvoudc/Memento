@startuml Retrieve Meeting Transcription

title Retrieve Meeting Summary

actor Client
participant "FastAPI Router" as Router
participant "Meeting Service" as Service
participant "Meeting Repository" as Repository

Client -> Router: Get /meetings/transcription{id}

activate Router
Router -> Service: get_meeting_transcription
Service -> Repository: retrieve_meeting_transcription

activate Repository
Service <-- Repository: meeting_transcription
deactivate Repository

Router <-- Service: meeting_transcription
deactivate Service

Client <-- Router: 200 OK + meeting_transcription

@enduml